<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <!-- net10.0: its trim/AOT analyzer recognizes the RuntimeFeature.IsDynamicCodeSupported guard the reflection fallback sits behind; net8.0's doesn't -->
    <TargetFramework>net10.0</TargetFramework>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- the pre-AOT way, kept under #if EASYBUILDER_LEGACY until the new path has run in the wild; uncomment to bring it back for a JIT app -->
    <!--<DefineConstants>$(DefineConstants);EASYBUILDER_LEGACY</DefineConstants>-->
    <VersionPrefix>3.0.0</VersionPrefix>
    <!--<VersionSuffix>rc1.7</VersionSuffix>-->
    <!-- OR: <Version>1.10-beta1.0</Version> -->
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>CommandLine.EasyBuilder</RootNamespace>
    <Authors>Nicholas Petersen</Authors>
    <RepositoryUrl>https://github.com/copernicus365/CommandLine.EasyBuilder</RepositoryUrl>
    <PackageProjectUrl>https://github.com/copernicus365/CommandLine.EasyBuilder</PackageProjectUrl>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>System.CommandLine, simple, functional, builder</PackageTags>
    <PackageReleaseNotes />
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <Description>Building upon the terrific `System.CommandLine`, `CommandLine.EasyBuilder` makes it easier than ever to make a command line app, offering view-model type of auto-binding of command-line options and arguments to the properties of a POCO class.</Description>
    <NoWarn>1701;1702;1591;</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" PackagePath="\" Pack="True" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.0" />
    <!--<ProjectReference Include="..\..\CommandLine\command-line-api-vcool\System.CommandLine\System.CommandLine.csproj" />-->
  </ItemGroup>

</Project>
